# AWS Region to deploy resources into (Free Tier: us-east-1)
aws_region = "us-east-1"

# Project naming prefix
project_name = "image-processor"

# Deployment environment (dev, prod)
environment = "dev"

# Free Tier eligible EC2 instance type
instance_type = "t3.micro"

# Network CIDR configuration
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"

# S3 Storage Lifecycle configuration
glacier_transition_days = 30
expiration_days         = 90
